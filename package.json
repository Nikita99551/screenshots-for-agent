{
  "name": "screenshots-for-agent",
  "version": "0.1.0",
  "description": "Серия скриншотов с разметкой и комментариями для вставки в чат с ИИ-агентом",
  "author": "Nikita99551",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python.ps1",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nikita99551.screenshots-for-agent",
    "productName": "Скриншоты для агента",
    "executableName": "ScreenshotsForAgent",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "scripts", "to": "scripts", "filter": ["helper.ps1", "copy-to-clipboard.ps1"] },
      { "from": "stt", "to": "stt", "filter": ["stt_server.py"] },
      { "from": "build/python", "to": "python", "filter": ["**/*", "!**/__pycache__/**", "!**/tests/**"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Скриншоты для агента",
      "runAfterFinish": true,
      "artifactName": "Screenshots-for-Agent-Setup-${version}.exe"
    }
  }
}
